NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Admin login (required — without this no one can log in)
# Set one or more invite codes; comma or newline separated
# ─────────────────────────────────────────────
RECRUIT_ADMIN_INVITE_CODES="change-me-secret-code"
# Aliases (any one of these also works):
# RECRUIT_ADMIN_INVITE_CODE="change-me-secret-code"
# RECRUIT_INVITE_CODE="change-me-secret-code"

# ─────────────────────────────────────────────
# Supabase / Database
# Primary auth is invite-code (cookie session), NOT Supabase Auth.
# DATABASE_URL is required for all DB operations (login, pipeline, schedules).
# NEXT_PUBLIC_SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are required for
# document storage (Supabase Storage) and optional Google OAuth.
# Note: NEXT_PUBLIC_SUPABASE_URL can be auto-derived from DATABASE_URL if omitted.
# ─────────────────────────────────────────────
# pgbouncer pooler URL — used by PrismaClient at runtime
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:6543/postgres?pgbouncer=true"
# direct connection — used by prisma migrate only
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ─────────────────────────────────────────────
# LINE Messaging API (required for B3 webhook)
# Get from: LINE Developers → Messaging API channel
# ─────────────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN="your-channel-access-token"
LINE_CHANNEL_SECRET="your-channel-secret"

# ─────────────────────────────────────────────
# LINE Harness (required after B2 Cloudflare deploy)
# Get from: LINE Harness admin dashboard → Staff → API Key
# ─────────────────────────────────────────────
LINE_HARNESS_API_URL="https://your-worker.workers.dev"
LINE_HARNESS_API_KEY="your-harness-api-key"
LINE_HARNESS_WEBHOOK_SECRET="change-me-random-string"
# Optional: UUID of "応募済み" tag in Harness to auto-attach on form submit
LINE_HARNESS_APPLIED_TAG_ID=""

# ─────────────────────────────────────────────
# Internal admin keys — required for server-side send/config routes
# (scripts/line-cli.mjs calls LINE API directly and does NOT use these keys)
# Leave empty → those routes return 401 for all requests (secure default).
# Pass the key as x-admin-key header when calling the routes via curl/HTTP.
# ─────────────────────────────────────────────
LINE_CLI_ADMIN_KEY=""
LINE_SETTINGS_ADMIN_KEY=""

# ─────────────────────────────────────────────
# Vercel Cron secret — required for /api/line/scheduled/process
# Set to a long random string; Vercel passes it as Authorization: Bearer <value>
# Leave empty → cron endpoint returns 401 for all requests.
# ─────────────────────────────────────────────
CRON_SECRET=""

# ─────────────────────────────────────────────
# AI (optional — for matching / resume analysis features)
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY="your-anthropic-api-key"
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-6
